{
  "openapi": "3.1.0",
  "info": {
    "title": "CircleCI selected operations",
    "version": "0.2.0",
    "description": "Reviewed local connector bindings for manual API import. No provider credentials are included; authentication and hosted execution require separate configuration and tests."
  },
  "servers": [
    {
      "url": "https://circleci.com/api/v2"
    }
  ],
  "paths": {
    "/project/{vcs}/{owner}/{repo}/pipeline": {
      "get": {
        "operationId": "list_project_pipelines",
        "summary": "List project pipelines.",
        "parameters": [
          {
            "name": "vcs",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "gh",
                "bb"
              ]
            }
          },
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "description": "Value"
            }
          },
          {
            "name": "repo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "description": "Value"
            }
          },
          {
            "name": "page-token",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "description": "Value"
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      }
    },
    "/pipeline/{pipeline_id}/workflow": {
      "get": {
        "operationId": "list_pipeline_workflows",
        "summary": "List pipeline workflows.",
        "parameters": [
          {
            "name": "pipeline_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "description": "Value"
            }
          },
          {
            "name": "page-token",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "description": "Value"
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      }
    },
    "/workflow/{workflow_id}/cancel": {
      "post": {
        "operationId": "cancel_workflow",
        "summary": "Cancel workflow.",
        "parameters": [
          {
            "name": "workflow_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "description": "Value"
            }
          }
        ],
        "x-pipmcp-read-only": false,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {},
                "required": []
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "providerAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Circle-Token"
      }
    }
  },
  "security": [
    {
      "providerAuth": []
    }
  ]
}
